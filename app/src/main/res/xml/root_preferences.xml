<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- TÍTULO 1: VOZ -->
    <PreferenceCategory
        app:title="@string/category_voice_title"
        app:icon="@drawable/ic_speed">

        <SwitchPreferenceCompat
            app:key="force_rate"
            app:title="@string/pref_force_rate"
            app:summary="@string/pref_force_rate_summary"
            app:defaultValue="false" />

        <com.rme.picottspro.SingleChoiceListPreference
            app:key="forced_rate_value"
            app:title="@string/pref_forced_rate_value"
            app:dependency="force_rate"
            app:defaultValue="50" />

        <SwitchPreferenceCompat
            app:key="force_pitch"
            app:title="@string/pref_force_pitch"
            app:summary="@string/pref_force_pitch_summary"
            app:defaultValue="false" />

        <com.rme.picottspro.SingleChoiceListPreference
            app:key="forced_pitch_value"
            app:title="@string/pref_forced_pitch_value"
            app:dependency="force_pitch"
            app:defaultValue="50" />

        <SwitchPreferenceCompat
            app:key="force_volume"
            app:title="@string/pref_force_volume"
            app:summary="@string/pref_force_volume_summary"
            app:defaultValue="false" />

        <com.rme.picottspro.SingleChoiceListPreference
            app:key="forced_volume_value"
            app:title="@string/pref_forced_volume_value"
            app:dependency="force_volume"
            app:defaultValue="100" />

        <SwitchPreferenceCompat
            app:key="force_voice"
            app:title="@string/pref_force_voice"
            app:summary="@string/pref_force_voice_summary"
            app:defaultValue="false" />

        <ListPreference
            app:key="default_voice"
            app:title="@string/pref_default_voice"
            app:summary="%s"
            app:entries="@array/voice_entries"
            app:entryValues="@array/voice_values"
            app:dependency="force_voice"
            app:defaultValue="spa-ESP" />
    </PreferenceCategory>

    <!-- TÍTULO 2: GENERAL -->
    <PreferenceCategory
        app:title="@string/category_general_title"
        app:icon="@drawable/ic_emoji">

        <SwitchPreferenceCompat
            app:key="read_emojis"
            app:title="@string/pref_read_emojis"
            app:summary="@string/pref_read_emojis_summary"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="process_punctuation"
            app:title="@string/pref_process_punctuation"
            app:summary="@string/pref_process_punctuation_summary"
            app:defaultValue="false" />

        <ListPreference
            app:key="punctuation_level"
            app:title="@string/pref_punctuation_level"
            app:summary="%s"
            app:entries="@array/punctuation_entries"
            app:entryValues="@array/punctuation_values"
            app:defaultValue="some"
            app:dependency="process_punctuation" />

        <SwitchPreferenceCompat
            app:key="process_numbers"
            app:title="@string/pref_process_numbers"
            app:summary="@string/pref_process_numbers_summary"
            app:defaultValue="false" />

        <ListPreference
            app:key="number_mode"
            app:title="@string/pref_number_mode"
            app:summary="%s"
            app:entries="@array/number_mode_entries"
            app:entryValues="@array/number_mode_values"
            app:defaultValue="3"
            app:dependency="process_numbers" />
    </PreferenceCategory>

    <!-- TÍTULO 3: DICCIONARIO DE USUARIO -->
    <PreferenceCategory
        app:title="@string/category_dictionary_title"
        app:icon="@drawable/ic_dictionary">

        <SwitchPreferenceCompat
            app:key="user_dictionary_enabled"
            app:title="@string/pref_user_dictionary_enabled"
            app:summary="@string/pref_user_dictionary_enabled_summary"
            app:defaultValue="false" />

        <Preference
            app:key="manage_dictionary"
            app:title="@string/pref_manage_dictionary"
            app:summary="@string/pref_manage_dictionary_summary"
            app:dependency="user_dictionary_enabled" />
    </PreferenceCategory>

    <!-- TÍTULO 4: VALORES POR DEFECTO -->
    <PreferenceCategory
        app:title="@string/category_defaults_title"
        app:icon="@drawable/ic_reset">

        <Preference
            app:key="reset_defaults"
            app:title="@string/pref_reset_defaults"
            app:summary="@string/pref_reset_defaults_summary" />
    </PreferenceCategory>

</PreferenceScreen>
